{
  "functions": {
    "api/visa-chat.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!assets/|.*\\.(?:js|css|json|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|eot)).*)",
      "destination": "/index.html"
    }
  ]
}