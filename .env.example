VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_CHECKOUT_ENDPOINT=https://your-production-domain.com

# =============================================================================
# FREE transactional email (Gmail) — Supabase Dashboard → Edge Functions → Secrets
# Do NOT add these to Vite .env (they must stay server-side only).
# =============================================================================
#
# 1) Use a Gmail you control (e.g. globalgateway@gmail.com)
# 2) Google Account → Security → turn on 2-Step Verification
# 3) Google Account → Security → App passwords → create one for "Mail"
# 4) Set secrets (replace values), then deploy the function:
#
#    npx supabase secrets set GMAIL_USER=yourname@gmail.com
#    npx supabase secrets set GMAIL_APP_PASSWORD=your16charapppassword
#    npx supabase secrets set EMAIL_FROM="Global Gateway <yourname@gmail.com>"
#    npx supabase secrets set PUBLIC_APP_URL=https://l-gateway-pro.vercel.app
#    npx supabase functions deploy send-transactional-email
#
# Cost: $0. No domain. ~500 emails/day per Gmail (Google limit).
# Optional: EMAIL_NOTIFY_EMBASSY_ON_SUBMIT=true

# =============================================================================
# Visa Support chat — Groq primary, local site guide fallback (Supabase secrets)
# 1) Groq (primary): https://console.groq.com → API Keys
#    npx supabase secrets set GROQ_API_KEY=your_groq_key
#    npx supabase secrets set GROQ_MODEL=llama-3.3-70b-versatile
# 2) Optional Gemini backup: GEMINI_API_KEY + GEMINI_MODEL=gemini-2.5-flash
#    npx supabase secrets set PUBLIC_APP_URL=https://l-gateway-pro.vercel.app
#    npx supabase functions deploy visa-support-chat
# 3) If both AI keys fail, function + browser still use site guide (no "sorry" loop)
# JWT for visa-support-chat: OFF (guests can chat)
# =============================================================================
